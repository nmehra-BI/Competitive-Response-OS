{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claim"
              },
              "claim": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["evidence", "assumption", "scenario", "actual", "inference_ai", "unknown"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "confidenceNote": {
                    "type": "null",
                    "default": null
                  }
                },
                "required": ["statement", "kind", "evidenceIds"],
                "additionalProperties": false
              }
            },
            "required": ["type", "claim"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "outcome_review_draft"
              },
              "whatWeLearned": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "causalLimitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recommendedOutcome": {
                "type": "string",
                "enum": ["proceed", "revise", "extend", "stop", "scale"]
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": ["type", "whatWeLearned", "causalLimitations", "recommendedOutcome", "rationale"],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "outcome-review output",
  "description": "SkillOutput (@growth-os/contracts) for outcome-review. Allowed proposal types: outcome_review_draft, claim."
}
