{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claim"
              },
              "claim": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["evidence", "assumption", "scenario", "actual", "inference_ai", "unknown"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "confidenceNote": {
                    "type": "null",
                    "default": null
                  }
                },
                "required": ["statement", "kind", "evidenceIds"],
                "additionalProperties": false
              }
            },
            "required": ["type", "claim"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "assumption_value"
              },
              "inputKey": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?\\d{1,18}(\\.\\d{1,8})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "valueText": {
                "type": ["string", "null"]
              },
              "basis": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/proposals/items/anyOf/0/properties/claim/properties/evidenceIds/items"
                }
              }
            },
            "required": ["type", "inputKey", "value", "valueText", "basis", "evidenceIds"],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bottom-up-sizing output",
  "description": "SkillOutput (@growth-os/contracts) for bottom-up-sizing. Allowed proposal types: assumption_value, claim."
}
