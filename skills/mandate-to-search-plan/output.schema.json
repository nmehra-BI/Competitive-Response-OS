{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "opportunity_candidate"
              },
              "name": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "fitRationale": {
                "type": "string"
              },
              "fitCriteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterion": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string",
                      "enum": ["met", "not_met", "unknown"]
                    }
                  },
                  "required": ["criterion", "result"],
                  "additionalProperties": false
                }
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "likelyDuplicateOfOpportunityId": {
                "anyOf": [
                  {
                    "$ref": "#/properties/proposals/items/anyOf/0/properties/evidenceIds/items"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "name",
              "trigger",
              "fitRationale",
              "fitCriteria",
              "unknowns",
              "evidenceIds",
              "likelyDuplicateOfOpportunityId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "search_plan"
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "geographies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notValidatedNotice": {
                "type": "string",
                "const": "AI draft · not validated"
              }
            },
            "required": ["type", "segments", "geographies", "queries", "notValidatedNotice"],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mandate-to-search-plan output",
  "description": "SkillOutput (@growth-os/contracts) for mandate-to-search-plan. Allowed proposal types: search_plan, opportunity_candidate."
}
