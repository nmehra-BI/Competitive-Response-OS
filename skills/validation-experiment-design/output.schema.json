{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claim"
              },
              "claim": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["evidence", "assumption", "scenario", "actual", "inference_ai", "unknown"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "confidenceNote": {
                    "type": "null",
                    "default": null
                  }
                },
                "required": ["statement", "kind", "evidenceIds"],
                "additionalProperties": false
              }
            },
            "required": ["type", "claim"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "experiment_design"
              },
              "assumptionIds": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/proposals/items/anyOf/0/properties/claim/properties/evidenceIds/items"
                }
              },
              "hypothesis": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "sampleText": {
                "type": "string"
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "thresholdText": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "thresholdText"],
                  "additionalProperties": false
                }
              },
              "decisionRules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "condition": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    }
                  },
                  "required": ["condition", "action"],
                  "additionalProperties": false
                }
              },
              "couldFalsify": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "assumptionIds",
              "hypothesis",
              "method",
              "sampleText",
              "metrics",
              "decisionRules",
              "couldFalsify"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validation-experiment-design output",
  "description": "SkillOutput (@growth-os/contracts) for validation-experiment-design. Allowed proposal types: experiment_design, claim."
}
