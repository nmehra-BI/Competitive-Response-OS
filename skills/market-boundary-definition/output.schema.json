{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claim"
              },
              "claim": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["evidence", "assumption", "scenario", "actual", "inference_ai", "unknown"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "confidenceNote": {
                    "type": "null",
                    "default": null
                  }
                },
                "required": ["statement", "kind", "evidenceIds"],
                "additionalProperties": false
              }
            },
            "required": ["type", "claim"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "market_boundary"
              },
              "marketUnit": {
                "type": "string"
              },
              "populationUnit": {
                "type": "string",
                "enum": ["site", "company", "customer"]
              },
              "includes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excludes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["type", "marketUnit", "populationUnit", "includes", "excludes"],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "market-boundary-definition output",
  "description": "SkillOutput (@growth-os/contracts) for market-boundary-definition. Allowed proposal types: market_boundary, claim."
}
