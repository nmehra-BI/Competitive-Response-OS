{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "pilot_task"
              },
              "title": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "suggestedOwnerId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deliverable": {
                "type": "string"
              },
              "dependsOnTitles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dueOffsetDays": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "title",
              "function",
              "suggestedOwnerId",
              "deliverable",
              "dependsOnTitles",
              "dueOffsetDays"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "message_draft"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": ["type", "title", "body"],
            "additionalProperties": false
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "proposals", "unknowns", "notChecked"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pilot-plan output",
  "description": "SkillOutput (@growth-os/contracts) for pilot-plan. Allowed proposal types: pilot_task, message_draft."
}
