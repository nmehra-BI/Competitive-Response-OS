# Copy to .env for local development. Never commit .env.
NODE_ENV=development

# Database (local PostgreSQL 16 cluster 16/main). Roles are created by `pnpm db:up`.
DATABASE_URL=postgres://me_app:me_app_dev@localhost:5432/growth_os
DATABASE_OWNER_URL=postgres://me_owner:me_owner_dev@localhost:5432/growth_os
DATABASE_WORKER_URL=postgres://me_worker:me_worker_dev@localhost:5432/growth_os

# Auth. `dev` enables the persona picker. Any other value disables /auth/dev-login.
AUTH_MODE=dev
SESSION_SECRET=change-me-in-dev-only
# Illustrative tenant offered by the dev persona picker (only illustrative tenants accept dev login).
DEV_TENANT_SLUG=aster-industrial
SESSION_TTL_MS=43200000
# Session cookie `Secure` flag. Browsers accept Secure cookies on http://localhost; set false only
# for a non-localhost plain-http dev host.
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=26214400

# Analysis provider: `fixture` (default, deterministic, no network) or `claude`.
ANALYSIS_PROVIDER=fixture
# Only read when ANALYSIS_PROVIDER=claude. The model name is configuration, never code.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=
ANALYSIS_RUN_WALL_TIME_MS=300000
# `false` turns analysis off: requests are refused with "Continue by hand"; every workflow still works.
ANALYSIS_ENABLED=true
# Optional: request timeout (ms) and prices per million tokens in micro-units, for run cost budgets.
ANALYSIS_REQUEST_TIMEOUT_MS=120000
ANALYSIS_INPUT_MICROS_PER_MTOK=0
ANALYSIS_OUTPUT_MICROS_PER_MTOK=0

# Task connector: `simulated` (default) or `jira` (not implemented in MVP scaffold).
TASK_CONNECTOR=simulated

# Object storage for source files (dev uses a local directory).
OBJECT_STORE_DIR=.data/objects

API_PORT=4000
WEB_PORT=5173
